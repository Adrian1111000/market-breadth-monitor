<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/run_daily.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <!-- Every weekday at 10:00 LOCAL time.

       Deliberately local rather than pinned to an offset. launchd reads the
       machine's timezone, so this follows the laptop: 10:00 in Macau today,
       10:00 in London after the move, and it picks up BST without anyone
       remembering to edit it in March and October.

       In the UK that lands at 09:00-10:00 New York, before or just after the
       opening bell, so each run covers the PREVIOUS US session with a full
       night for the vendor to publish it. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <!-- If the Mac was asleep at 06:00, run once it wakes rather than skipping. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__ROOT__/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/logs/launchd.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
